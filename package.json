{
  "name": "neurologue",
  "version": "0.9.0",
  "description": "A local-first cognitive system for capturing, organising, and understanding your thoughts.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "icons": "node scripts/render-icons.js",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.codebureau.neurologue",
    "productName": "Neurologue",
    "copyright": "Copyright © 2025 Codebureau",
    "icon": "build/icon.png",
    "files": [
      "**/*",
      "!tests/**",
      "!docs/**",
      "!website/**",
      "!dist/**",
      "!.github/**",
      "!build/**",
      "!**/*.test.js"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/@lancedb/**",
      "**/*.node"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/tests/__mocks__/electron.js"
    }
  },
  "keywords": [],
  "author": {
    "name": "Codebureau",
    "email": "neurologue@codebureau.com"
  },
  "license": "TBD",
  "dependencies": {
    "@lancedb/lancedb": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "apache-arrow": "^18.1.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jest": "^30.3.0",
    "png-to-ico": "^3.0.1"
  }
}
