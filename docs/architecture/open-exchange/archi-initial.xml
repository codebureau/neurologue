    <relationship identifier="rel-goal-canonical-corpus-cap-export" xsi:type="Realization"
                  source="cap-export-interoperability" target="goal-canonical-corpus"/>
    <relationship identifier="rel-goal-safe-ai-cap-local-ai" xsi:type="Realization"
