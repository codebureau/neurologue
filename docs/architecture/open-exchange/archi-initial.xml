<?xml version="1.0" encoding="UTF-8"?>
<model
    xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
    identifier="id-neurologue-architecture">

  <name xml:lang="en">Neurologue Architecture</name>

  <!-- ========= ELEMENTS ========= -->
  <elements>

    <!-- Motivation / Drivers -->
    <element identifier="drv-privacy" xsi:type="Driver">
      <name xml:lang="en">Privacy and Compliance</name>
    </element>
    <element identifier="drv-local-first" xsi:type="Driver">
      <name xml:lang="en">Local First Knowledge Control</name>
    </element>
    <element identifier="drv-cognitive-offload" xsi:type="Driver">
      <name xml:lang="en">Cognitive Offload</name>
    </element>
    <element identifier="drv-interoperability" xsi:type="Driver">
      <name xml:lang="en">Tool Interoperability</name>
    </element>

    <!-- Goals -->
    <element identifier="goal-local-pkm" xsi:type="Goal">
      <name xml:lang="en">Local First Personal Knowledge Engine</name>
    </element>
    <element identifier="goal-canonical-corpus" xsi:type="Goal">
      <name xml:lang="en">Single Canonical Corpus</name>
    </element>
    <element identifier="goal-safe-ai" xsi:type="Goal">
      <name xml:lang="en">Safe and Transparent AI Usage</name>
    </element>
    <element identifier="goal-reduced-fragmentation" xsi:type="Goal">
      <name xml:lang="en">Reduced Knowledge Fragmentation</name>
    </element>
    <element identifier="goal-interoperable-ai-tools" xsi:type="Goal">
      <name xml:lang="en">Interoperable AI and Local Tools</name>
    </element>

    <!-- Outcomes (as Goals for simplicity) -->
    <element identifier="outcome-less-context-switching" xsi:type="Goal">
      <name xml:lang="en">Less Context Switching Between Tools</name>
    </element>
    <element identifier="outcome-better-recall" xsi:type="Goal">
      <name xml:lang="en">Improved Recall of Past Work</name>
    </element>

    <!-- Capabilities -->
    <element identifier="cap-corpus-management" xsi:type="Capability">
      <name xml:lang="en">Corpus Management</name>
    </element>
    <element identifier="cap-retrieval-insight" xsi:type="Capability">
      <name xml:lang="en">Retrieval and Insight</name>
    </element>
    <element identifier="cap-export-interoperability" xsi:type="Capability">
      <name xml:lang="en">Export and Interoperability</name>
    </element>
    <element identifier="cap-agentic-automation" xsi:type="Capability">
      <name xml:lang="en">Agentic Automation</name>
    </element>
    <element identifier="cap-local-ai-orchestration" xsi:type="Capability">
      <name xml:lang="en">Local AI Orchestration</name>
    </element>

    <!-- Courses of Action -->
    <element identifier="coa-ccf-canonical" xsi:type="CourseOfAction">
      <name xml:lang="en">Adopt CCF as Canonical Format</name>
    </element>
    <element identifier="coa-run-ai-locally" xsi:type="CourseOfAction">
      <name xml:lang="en">Run Language Models Locally</name>
    </element>
    <element identifier="coa-expose-mcp" xsi:type="CourseOfAction">
      <name xml:lang="en">Expose MCP Interface for Tools</name>
    </element>
    <element identifier="coa-local-first-storage" xsi:type="CourseOfAction">
      <name xml:lang="en">Use Local Storage for Corpus</name>
    </element>

    <!-- Application Components -->
    <element identifier="app-frontend" xsi:type="ApplicationComponent">
      <name xml:lang="en">Neurologue Frontend</name>
    </element>
    <element identifier="app-backend" xsi:type="ApplicationComponent">
      <name xml:lang="en">Neurologue Backend</name>
    </element>
    <element identifier="app-ccf-export" xsi:type="ApplicationComponent">
      <name xml:lang="en">CCF Export Engine</name>
    </element>
    <element identifier="app-ccf-import" xsi:type="ApplicationComponent">
      <name xml:lang="en">CCF Import Engine</name>
    </element>
    <element identifier="app-ccf-validate" xsi:type="ApplicationComponent">
      <name xml:lang="en">CCF Validation Component</name>
    </element>
    <element identifier="app-ccf-diff" xsi:type="ApplicationComponent">
      <name xml:lang="en">CCF Diff Engine</name>
    </element>
    <element identifier="app-mcp-server" xsi:type="ApplicationComponent">
      <name xml:lang="en">MCP Server</name>
    </element>
    <element identifier="app-embedding-worker" xsi:type="ApplicationComponent">
      <name xml:lang="en">Embedding Worker</name>
    </element>
    <element identifier="app-search-layer" xsi:type="ApplicationComponent">
      <name xml:lang="en">Search Layer</name>
    </element>
    <element identifier="app-agent-runner" xsi:type="ApplicationComponent">
      <name xml:lang="en">Agent Runner</name>
    </element>
    <element identifier="app-settings-manager" xsi:type="ApplicationComponent">
      <name xml:lang="en">Settings Manager</name>
    </element>

    <!-- Data Objects -->
    <element identifier="data-entry" xsi:type="DataObject">
      <name xml:lang="en">Entry</name>
    </element>
    <element identifier="data-theme" xsi:type="DataObject">
      <name xml:lang="en">Theme</name>
    </element>
    <element identifier="data-ccf-snapshot" xsi:type="DataObject">
      <name xml:lang="en">CCF Snapshot</name>
    </element>
    <element identifier="data-ccf-entries" xsi:type="DataObject">
      <name xml:lang="en">CCF Entries File</name>
    </element>
    <element identifier="data-ccf-themes" xsi:type="DataObject">
      <name xml:lang="en">CCF Themes File</name>
    </element>
    <element identifier="data-ccf-metadata" xsi:type="DataObject">
      <name xml:lang="en">CCF Metadata File</name>
    </element>
    <element identifier="data-embeddings" xsi:type="DataObject">
      <name xml:lang="en">Embeddings</name>
    </element>
    <element identifier="data-media-file" xsi:type="DataObject">
      <name xml:lang="en">Media File</name>
    </element>
    <element identifier="data-settings" xsi:type="DataObject">
      <name xml:lang="en">User Settings</name>
    </element>

    <!-- Technology / Infrastructure -->
    <element identifier="node-user-device" xsi:type="Node">
      <name xml:lang="en">User Device</name>
    </element>
    <element identifier="tech-os" xsi:type="SystemSoftware">
      <name xml:lang="en">Operating System</name>
    </element>
    <element identifier="tech-filesystem" xsi:type="SystemSoftware">
      <name xml:lang="en">Local File System</name>
    </element>
    <element identifier="tech-sqlite" xsi:type="SystemSoftware">
      <name xml:lang="en">SQLite Engine</name>
    </element>
    <element identifier="tech-ollama" xsi:type="SystemSoftware">
      <name xml:lang="en">Ollama Runtime</name>
    </element>
    <element identifier="tech-node-runtime" xsi:type="SystemSoftware">
      <name xml:lang="en">Node Runtime</name>
    </element>
    <element identifier="tech-electron-shell" xsi:type="SystemSoftware">
      <name xml:lang="en">Electron Shell</name>
    </element>

    <!-- Artifacts (optional but useful) -->
    <element identifier="artifact-db-file" xsi:type="Artifact">
      <name xml:lang="en">Neurologue Database File</name>
    </element>
    <element identifier="artifact-embeddings-folder" xsi:type="Artifact">
      <name xml:lang="en">Embeddings Folder</name>
    </element>
    <element identifier="artifact-media-folder" xsi:type="Artifact">
      <name xml:lang="en">Media Folder</name>
    </element>
    <element identifier="artifact-ccf-folder" xsi:type="Artifact">
      <name xml:lang="en">CCF Export Folder</name>
    </element>

  </elements>

  <!-- ========= RELATIONSHIPS ========= -->
  <relationships>

    <!-- Drivers influence Goals -->
    <relationship identifier="rel-drv-privacy-goal-safe-ai" xsi:type="Influence"
                  source="drv-privacy" target="goal-safe-ai"/>
    <relationship identifier="rel-drv-local-first-goal-local-pkm" xsi:type="Influence"
                  source="drv-local-first" target="goal-local-pkm"/>
    <relationship identifier="rel-drv-cognitive-offload-goal-reduced-fragmentation" xsi:type="Influence"
                  source="drv-cognitive-offload" target="goal-reduced-fragmentation"/>
    <relationship identifier="rel-drv-interoperability-goal-interoperable-ai-tools" xsi:type="Influence"
                  source="drv-interoperability" target="goal-interoperable-ai-tools"/>

